      "id": "6d506601-c087-42d8-b9f7-33a1b0602dd1",
      "name": "Ejecutar manualmente"
    },
    {
      "parameters": {
        "jsCode": "const codigoProceso = String($json.codigoProceso || '').trim();\n\nlet html = String($json.htmlDocumentos || '')\n  .replace(/\\\\([\"'<>])/g, '$1')\n  .replace(/documentFileId=['\"]\\s*\\+\\s*['\"]/gi, 'documentFileId=');\n\nif (!codigoProceso) {\n  throw new Error('Falta el campo codigoProceso.');\n}\n\nif (!html) {\n  throw new Error('Falta el campo htmlDocumentos.');\n}\n\nconst baseUrl = 'https://community.secop.gov.co';\n\nconst limpiar = (texto) =>\n  texto\n    .replace(/<[^>]*>/g, '')\n    .replace(/&amp;/g, '&')\n    .replace(/&nbsp;/g, ' ')\n    .trim();\n\nconst nombreSeguro = (nombre) =>\n  nombre.replace(/[\\\\/:*?\"<>|]/g, '_').replace(/\\s+/g, ' ').trim();\n\nconst filas = html.match(/<tr\\b[\\s\\S]*?<\\/tr>/gi) || [];\nconst salida = [];\nlet numero = 0;\n\nfor (const fila of filas) {\n  const nombre = fila.match(\n    /id=[\"'][^\"']*spnDocumentName[^\"']*[\"'][^>]*>([\\s\\S]*?)<\\/span>/i\n  );\n\n  const archivoId = fila.match(/documentFileId\\s*=\\s*(\\d+)/i);\n  const mkey = fila.match(/mkey\\s*=\\s*([^'\"&\\s<]+)/i);\n\n  if (!nombre || !archivoId || !mkey) {\n    continue;\n  }\n\n  numero++;\n\n  const nombreOriginal = limpiar(nombre[1]);\n\n  salida.push({\n    json: {\n      codigoProceso,\n      carpetaDestino: codigoProceso,\n      fileNameOriginal: nombreOriginal,\n      fileNameDescarga:\n        `${nombreSeguro(codigoProceso)}__${String(numero).padStart(2, '0')}__${nombreSeguro(nombreOriginal)}`,\n      downloadUrl:\n        `${baseUrl}/Public/Tendering/OpportunityDetail/DownloadFile` +\n        `?documentFileId=${archivoId[1]}&mkey=${mkey[1]}`\n    }\n  });\n}\n\nif (salida.length === 0) {\n  throw new Error(\n    `No encontré documentos. Longitud de htmlDocumentos: ${html.length} caracteres.`\n  );\n}\n\nreturn salida;"
      },
